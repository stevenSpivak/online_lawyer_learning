@page "/teacher"
@using view.Services
@using Model

@inject ClassApiClient ClassApi
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>ניהול מורה | חוק וזכות</PageTitle>

@if (!Session.IsLoggedIn)
{
    Navigation.NavigateTo("/login");
}
else if (Session.RoleName != "Teacher")
{
    Navigation.NavigateTo("/no-permission");
}
else
{

    <div class="page-heading">
        <div>
            <span class="eyebrow">מרחב למורים</span>
            <h1>ניהול כיתות לימוד</h1>
            <p>יצירת כיתות, מעקב אחר תלמידים וארגון חומרי הלמידה.</p>
        </div>

        <button class="btn btn-primary" @onclick="ToggleCreate">
            ＋ יצירת כיתה חדשה
        </button>
    </div>

    @if (showCreate)
    {
        <section class="panel create-class-panel">
            <div>
                <h2>יצירת כיתה חדשה</h2>
                <p>הזינו שם לכיתה כדי להציג אותה ברשימה.</p>
            </div>

            <div class="create-class-form">
                <input @bind="newClassName"
                placeholder="לדוגמה: מבוא לזכויות אזרח" />

                <button class="btn btn-primary"
                        disabled="@isSaving"
                        @onclick="CreateClass">
                    @(isSaving ? "שומר..." : "יצירת כיתה")
                </button>

                <button class="btn btn-secondary" @onclick="ToggleCreate">
                    ביטול
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(createMessage))
            {
                <p class="inline-feedback feedback-success">
                    @createMessage
                </p>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(pageMessage))
    {
        <div class="inline-feedback feedback-success">
            @pageMessage
        </div>
    }

    <section class="stats-grid stats-grid-four">
        <div class="stat-card panel">
            <div class="stat-icon icon-blue">♧</div>
            <div>
                <span>תלמידים</span>
                <strong>52</strong>
                <small>בשתי כיתות</small>
            </div>
        </div>

        <div class="stat-card panel">
            <div class="stat-icon icon-teal">▤</div>
            <div>
                <span>כיתות פעילות</span>
                <strong>@classrooms.Count</strong>
                <small>כולל כיתות שנוצרו כאן</small>
            </div>
        </div>

        <div class="stat-card panel">
            <div class="stat-icon icon-violet">☏</div>
            <div>
                <span>פניות ממתינות</span>
                <strong>4</strong>
                <small>דורשות מעקב</small>
            </div>
        </div>

        <div class="stat-card panel">
            <div class="stat-icon icon-gold">✓</div>
            <div>
                <span>חומרי למידה</span>
                <strong>12</strong>
                <small>במאגר לדוגמה</small>
            </div>
        </div>
    </section>

    <section class="panel management-panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">הקבוצות שלי</span>
                <h2>כיתות לימוד</h2>
            </div>

            <div class="table-toolbar">
                <input @bind="classSearch"
                @bind:event="oninput"
                placeholder="חיפוש כיתה..." />

                <span class="pill pill-blue">
                    @FilteredClasses.Count() כיתות
                </span>
            </div>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>שם הכיתה</th>
                        <th>קוד הצטרפות</th>
                        <th>תלמידים</th>
                        <th>סטטוס</th>
                        <th>פעולות</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var classroom in FilteredClasses)
                    {
                        <tr>
                            <td>
                                <div class="table-primary-cell">
                                    <span class="table-icon">▤</span>
                                    <div>
                                        <strong>@classroom.Name</strong>
                                        <small>@classroom.Name</small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="code-chip">@classroom.Code</span>
                            </td>

                            <td>@classroom.Students</td>

                            <td>
                                <span class="pill pill-green">פעילה</span>
                            </td>

                            <td>
                                <button class="table-action"
                                @onclick="() => ShowClass(classroom.Name)">
                                    צפייה
                                </button>

                                <button class="table-action table-action-danger"
                                        @onclick="() => RemoveClass(classroom)">
                                    הסרה
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!FilteredClasses.Any())
        {
            <div class="empty-inline">
                לא נמצאו כיתות שתואמות לחיפוש.
            </div>
        }
    </section>

    <section class="panel management-panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">מעקב לימודי</span>
                <h2>תלמידים אחרונים</h2>
            </div>

            <a class="text-link" href="/admin">
                לניהול משתמשים ←
            </a>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>תלמיד/ה</th>
                        <th>כיתה</th>
                        <th>התקדמות</th>
                        <th>פעילות אחרונה</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>
                            <div class="person-cell">
                                <span class="avatar avatar-table">א</span>
                                <strong>איתי ברק</strong>
                            </div>
                        </td>
                        <td>זכויות אדם ואזרח</td>
                        <td>
                            <div class="table-progress">
                                <div class="progress-track">
                                    <span style="width:80%"></span>
                                </div>
                                <small>80%</small>
                            </div>
                        </td>
                        <td>היום, 10:24</td>
                    </tr>

                    <tr>
                        <td>
                            <div class="person-cell">
                                <span class="avatar avatar-table avatar-mint">ש</span>
                                <strong>שירה לוי</strong>
                            </div>
                        </td>
                        <td>זכויות אדם ואזרח</td>
                        <td>
                            <div class="table-progress">
                                <div class="progress-track">
                                    <span style="width:55%"></span>
                                </div>
                                <small>55%</small>
                            </div>
                        </td>
                        <td>אתמול, 14:10</td>
                    </tr>

                    <tr>
                        <td>
                            <div class="person-cell">
                                <span class="avatar avatar-table avatar-lilac">ד</span>
                                <strong>דניאל כהן</strong>
                            </div>
                        </td>
                        <td>חוקי יסוד בישראל</td>
                        <td>
                            <div class="table-progress">
                                <div class="progress-track">
                                    <span style="width:30%"></span>
                                </div>
                                <small>30%</small>
                            </div>
                        </td>
                        <td>17.10.2026</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    @code
    {
        private List<Classroom> classrooms = new();

        private string classSearch = "";
        private bool showCreate;
        private string newClassName = "";
        private string createMessage = "";
        private string pageMessage = "";

        private bool isLoading;
        private bool isSaving;

        private IEnumerable<Classroom> FilteredClasses =>
            classrooms.Where(c =>
                c.Name.Contains(
                    classSearch.Trim(),
                    StringComparison.OrdinalIgnoreCase));

        protected override async Task OnInitializedAsync()
        {
            if (!Session.IsLoggedIn)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            if (Session.RoleName != "Teacher")
            {
                Navigation.NavigateTo("/no-permission");
                return;
            }

            await LoadClassesAsync();
        }

        // טוען את הכיתות האמיתיות ממסד הנתונים.
        private async Task LoadClassesAsync()
        {
            isLoading = true;

            try
            {
                classrooms =
                    await ClassApi.GetTeacherClassesAsync(
                        Session.UserId);
            }
            catch (HttpRequestException)
            {
                pageMessage =
                    "לא ניתן להתחבר לשרת כרגע.";
            }
            finally
            {
                isLoading = false;
            }
        }

        private void ToggleCreate()
        {
            showCreate = !showCreate;
            createMessage = "";
        }

        // יוצר כיתה ושומר אותה במסד הנתונים.
        private async Task CreateClass()
        {
            createMessage = "";

            string name =
                newClassName.Trim();

            if (name.Length < 3)
            {
                createMessage =
                    "שם הכיתה צריך להכיל לפחות 3 תווים.";
                return;
            }

            isSaving = true;

            try
            {
                bool created =
                    await ClassApi.CreateClassAsync(
                        name,
                        Session.UserId);

                if (!created)
                {
                    createMessage =
                        "לא ניתן ליצור את הכיתה.";
                    return;
                }

                newClassName = "";

                createMessage =
                    "הכיתה נוצרה ונשמרה במסד הנתונים.";

                pageMessage = "";

                await LoadClassesAsync();
            }
            catch (HttpRequestException)
            {
                createMessage =
                    "השרת לא זמין כרגע.";
            }
            finally
            {
                isSaving = false;
            }
        }

        // מוחק כיתה ממסד הנתונים.
        private async Task RemoveClass(
            Classroom classroom)
        {
            try
            {
                bool deleted =
                    await ClassApi.DeleteClassAsync(
                        classroom.Id,
                        Session.UserId);

                if (!deleted)
                {
                    pageMessage =
                        "לא ניתן להסיר את הכיתה.";
                    return;
                }

                pageMessage =
                    $"הכיתה ״{classroom.Name}״ הוסרה.";

                await LoadClassesAsync();
            }
            catch (HttpRequestException)
            {
                pageMessage =
                    "השרת לא זמין כרגע.";
            }
        }

        private void ShowClass(string name)
        {
            pageMessage =
                $"נבחרה הכיתה ״{name}״.";
        }
    }
}