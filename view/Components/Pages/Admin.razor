@page "/admin"

@using System.Net.Http.Json
@using Model
@using view.Services

@inject LawApiClient LawApi
@inject HttpClient Http
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>ניהול מערכת | חוק וזכות</PageTitle>

@if (!isAuthorized)
{
    <p>מעביר אותך...</p>
}
else
{
    <div class="page-heading">
        <div>
            <span class="eyebrow">אזור מנהל מערכת</span>
            <h1>ניהול המערכת</h1>
            <p>ניהול משתמשים, הרשאות ותוכן כדי לשמור על סביבת למידה בטוחה.</p>
        </div>
        <div class="heading-icon">⚙</div>
    </div>

    @if (!string.IsNullOrWhiteSpace(feedback))
    {
        <div class="inline-feedback feedback-success">
            @feedback
        </div>
    }

    @* Statistics *@
    <section class="stats-grid stats-grid-three">

        <div class="stat-card panel">
            <div class="stat-icon icon-blue">♙</div>
            <div>
                <span>משתמשים רשומים</span>
                <strong>@users.Count</strong>
                <small>משתמשים במסד הנתונים</small>
            </div>
        </div>

        <div class="stat-card panel">
            <div class="stat-icon icon-gold">◷</div>
            <div>
                <span>משתמשים חסומים</span>
                <strong>@users.Count(u => !u.IsActive)</strong>
                <small>חשבונות שאינם פעילים</small>
            </div>
        </div>

        <div class="stat-card panel">
            <div class="stat-icon icon-teal">▤</div>
            <div>
                <span>תכנים במאגר</span>
                <strong>@lawCount</strong>
                <small>חוקים ונושאים במאגר</small>
            </div>
        </div>

    </section>

    @* User Management *@
    <section class="panel management-panel">

        <div class="panel-heading">
            <div>
                <span class="eyebrow">הרשאות וגישה</span>
                <h2>ניהול משתמשים</h2>
            </div>

            <div class="table-toolbar">

                <input @bind="userSearch"
                       @bind:event="oninput"
                       placeholder="חיפוש משתמש..." />

                <select @bind="roleFilter">
                    <option value="כל התפקידים">כל התפקידים</option>
                    <option value="תלמיד">תלמיד</option>
                    <option value="מורה">מורה</option>
                    <option value="מנהל מערכת">מנהל מערכת</option>
                </select>

            </div>
        </div>

        @if (isLoadingUsers)
        {
            <p>טוען משתמשים...</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">

                    <thead>
                        <tr>
                            <th>משתמש</th>
                            <th>אימייל</th>
                            <th>תפקיד</th>
                            <th>סטטוס</th>
                            <th>פעולות</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            <tr @key="user.Id">

                                <td>
                                    <div class="person-cell">
                                        <span class="avatar avatar-table">
                                            @(string.IsNullOrWhiteSpace(user.Username)
                                                ? "?"
                                                : user.Username.Substring(0, 1).ToUpper())
                                        </span>

                                        <strong>@user.Username</strong>
                                    </div>
                                </td>

                                <td>@user.Email</td>

                                <td>@GetHebrewRole(user.RoleName)</td>

                                <td>
                                    <span class="pill @(user.IsActive ? "pill-green" : "pill-gray")">
                                        @(user.IsActive ? "פעיל" : "חסום")
                                    </span>
                                </td>

                                <td>
                                    <button class="table-action @(user.IsActive ? "table-action-danger" : "")"
                                            disabled="@isUpdatingUser"
                                            @onclick="() => ToggleBlock(user)">

                                        @(user.IsActive ? "חסימה" : "פתיחה")

                                    </button>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            @if (!FilteredUsers.Any())
            {
                <div class="empty-inline">
                    לא נמצאו משתמשים מתאימים.
                </div>
            }
        }

    </section>

    <div class="admin-note">
        <span>ⓘ</span>
        <p>
            נתוני המשתמשים והתכנים נטענים ממסד הנתונים דרך השרת.
            פעולות הניהול נשמרות במסד הנתונים.
        </p>
    </div>
}

@code {

    private bool isAuthorized;
    private bool isLoadingUsers;
    private bool isUpdatingUser;

    private int lawCount;

    private List<User> users = new();

    private string userSearch = "";
    private string roleFilter = "כל התפקידים";
    private string feedback = "";

    // Filter users by role, username or email
    private IEnumerable<User> FilteredUsers =>
        users.Where(user =>
            (roleFilter == "כל התפקידים" ||
             GetHebrewRole(user.RoleName) == roleFilter)
            &&
            $"{user.Username} {user.Email}".Contains(
                userSearch.Trim(),
                StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        // Check login
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Check administrator permission
        if (Session.RoleName != "Admin")
        {
            Navigation.NavigateTo("/no-permission");
            return;
        }

        isAuthorized = true;

        await LoadUsersAsync();

        try
        {
            var laws = await LawApi.GetLawsAsync();
            lawCount = laws?.Count ?? 0;
        }
        catch (HttpRequestException)
        {
            lawCount = 0;
            feedback = "לא ניתן לטעון את התכנים מהשרת.";
        }
    }

    // Load users from API
    private async Task LoadUsersAsync()
    {
        isLoadingUsers = true;

        try
        {
            users = await Http.GetFromJsonAsync<List<User>>("api/users")
                    ?? new List<User>();
        }
        catch (HttpRequestException)
        {
            feedback = "לא ניתן לטעון את המשתמשים מהשרת.";
        }
        finally
        {
            isLoadingUsers = false;
        }
    }

    // Translate role names to Hebrew
    private string GetHebrewRole(string? roleName)
    {
        return roleName switch
        {
            "Admin" => "מנהל מערכת",
            "Teacher" => "מורה",
            _ => "תלמיד"
        };
    }

    // Block or unblock a user
    private async Task ToggleBlock(User user)
    {
        if (isUpdatingUser)
            return;

        isUpdatingUser = true;

        bool newStatus = !user.IsActive;

        try
        {
            using HttpResponseMessage response = await Http.PutAsync(
                $"api/users/{user.Id}/status?isActive={newStatus}",
                null);

            if (!response.IsSuccessStatusCode)
            {
                feedback = "לא ניתן לשנות את סטטוס המשתמש.";
                return;
            }

            user.IsActive = newStatus;

            feedback = newStatus
                ? $"הגישה של ״{user.Username}״ הופעלה."
                : $"המשתמש ״{user.Username}״ נחסם.";
        }
        catch (HttpRequestException)
        {
            feedback = "השרת לא זמין כרגע.";
        }
        finally
        {
            isUpdatingUser = false;
        }
    }
}